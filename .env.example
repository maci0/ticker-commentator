# ── HuggingFace ──────────────────────────────────────────────────────
# Optional: speeds up model downloads and avoids rate limits on first run.
# HF_TOKEN=

# ── Live mode ────────────────────────────────────────────────────────
# Speculative prefetch: during audio playback, pre-generate the next no-move
# update in a background thread so interval/insignificant-move ticks serve
# instantly instead of blocking ~4s. 1 = on (default), 0 = off.
LIVE_PREFETCH=1
# Live ticks whose move is below this percent reuse the prefetched no-move line;
# moves at/above it get fresh move-aware commentary.
LIVE_PREFETCH_TOLERANCE_PCT=0.05
# Stream audio to the player as it decodes (first audio ~1.3s vs ~3.5s full clip)
# via a local 127.0.0.1 HTTP server. LOCAL playback only — set 0 for remote/hosted
# Streamlit (the browser must reach 127.0.0.1). 1 = on (default), 0 = off.
STREAM_AUDIO=1
STREAM_AUDIO_PORT=0              # 0 = OS-assigned port; set a fixed port if needed
# Lower ORPHEUS_CHUNK_FRAMES (below) for even earlier first audio when streaming.

# ── GPU selection ────────────────────────────────────────────────────
# Which GPU index to use. Defaults to 0 (the discrete GPU). This is set
# BEFORE torch/llama.cpp init to stop llama.cpp from splitting layers onto a
# weak integrated GPU (e.g. a Ryzen iGPU), which crashes inference when the
# build lacks that GPU's kernels. Set empty to leave device selection untouched
# (e.g. genuine multi-GPU setups using *_TENSOR_SPLIT).
GPU_DEVICE=0

# ── Debug ────────────────────────────────────────────────────────────
# Set to 1 to enable verbose logging; 0 = off (default), 1 = on.
APP_DEBUG=0
COMMENTARY_DEBUG=0
ORPHEUS_TTS_DEBUG=0

# ── Commentary LLM (llama.cpp) ──────────────────────────────────────
COMMENTARY_EMOTE_CHANCE_1=0.75    # probability of first Orpheus emotion tag
COMMENTARY_EMOTE_CHANCE_2=0.50    # probability of second emotion tag
COMMENTARY_TEMPERATURE=0.7        # LLM sampling temperature
COMMENTARY_TOP_P=0.9              # LLM nucleus sampling threshold
COMMENTARY_REPEAT_PENALTY=1.2    # >1.0 stops small models looping; 1.0 = off
COMMENTARY_MAX_TOKENS=96          # max output tokens per commentary line
COMMENTARY_GGUF_REPO=unsloth/Qwen3.5-4B-GGUF     # fast + follows the one-line rule; needs llama-cpp-python >= 0.3.23 (qwen35 arch)
COMMENTARY_GGUF_FILE=Qwen3.5-4B-Q8_0.gguf        # Qwen3.5-0.8B is faster but ignores length limits and rambles
COMMENTARY_CTX=4096
COMMENTARY_BATCH=512              # prompt prefill batch (llama.cpp default 512)
COMMENTARY_UBATCH=512            # physical micro-batch for prefill
COMMENTARY_FLASH_ATTN=1          # 1 = flash attention on (faster, less KV memory); 0 = off
COMMENTARY_WARMUP=1              # warm LLM kernels at load so first line isn't slow; 0 = off
COMMENTARY_GPU_LAYERS=-1          # -1 = all layers on GPU, 0 = CPU only
COMMENTARY_MAIN_GPU=0
COMMENTARY_TENSOR_SPLIT=1.0       # comma-separated for multi-GPU

# ── TTS engine ───────────────────────────────────────────────────────
# orpheus (default, built-in, fastest: warm RTF ~0.62) | chatterbox (most
# expressive, RTF ~1.5) | kokoro (fastest synth but flat emotion). chatterbox
# and kokoro need a separate install — see docs/tts_engines.md.
TTS_ENGINE=orpheus
# CHATTERBOX_EXAGGERATION=0.8    # 0.8 best in eval; >1.0 hurts naturalness
# CHATTERBOX_CFG=0.5
# KOKORO_VOICE=am_michael        # see kokoro voice list
# KOKORO_LANG=a                  # 'a' = American English

# ── Orpheus TTS (llama.cpp) ─────────────────────────────────────────
ORPHEUS_GGUF_REPO=isaiahbjork/orpheus-3b-0.1-ft-Q4_K_M-GGUF
ORPHEUS_GGUF_FILE=orpheus-3b-0.1-ft-q4_k_m.gguf
ORPHEUS_LLAMA_CTX=4096
ORPHEUS_LLAMA_BATCH=512           # prompt prefill batch (llama.cpp default 512)
ORPHEUS_LLAMA_UBATCH=512         # physical micro-batch for prefill
ORPHEUS_LLAMA_FLASH_ATTN=1       # 1 = flash attention on (faster long token gen); 0 = off
ORPHEUS_LLAMA_GPU_LAYERS=-1       # -1 = all layers on GPU, 0 = CPU only
ORPHEUS_LLAMA_MAIN_GPU=0
ORPHEUS_LLAMA_TENSOR_SPLIT=1.0    # comma-separated for multi-GPU

# ── Orpheus TTS audio ───────────────────────────────────────────────
ORPHEUS_TEMPERATURE=0.6
ORPHEUS_TOP_P=0.9
ORPHEUS_SAMPLE_RATE=24000
ORPHEUS_TTS_MAX_SECONDS=60        # max decode time; stops runaway/looping generation
ORPHEUS_CHUNK_FRAMES=24           # SNAC frames per audio chunk
ORPHEUS_TTS_WARMUP=1             # warm LLM + SNAC at load so first audio isn't stalled; 0 = off
